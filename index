                Clear Chat
              </button>
            </div>

            {/* Chat Messages List */}
            <div className="flex-1 overflow-y-auto p-3 sm:p-5 space-y-4">
              
              {/* Quick Prompt Chips */}
              {messages.length <= 2 && (
                <div className="mb-4 bg-indigo-50/70 border border-indigo-100 p-3 sm:p-4 rounded-2xl">
                  <p className="text-xs font-bold text-indigo-900 uppercase tracking-wider mb-2">⚡ Popular Quick Study Prompts:</p>
                  <div className="flex flex-wrap gap-2">
                    {suggestedQueries.map((q, idx) => (
                      <button
                        key={idx}
                        onClick={() => handleSendMessage(null, q)}
                        className="bg-white hover:bg-indigo-600 hover:text-white border border-indigo-200 text-indigo-800 text-xs py-1.5 px-3 rounded-xl transition-all shadow-sm font-medium text-left"
                      >
                        {q}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {messages.map((msg) => (
                <div
                  key={msg.id}
                  className={`flex w-full ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}
                >
                  <div className={`flex max-w-[90%] sm:max-w-[80%] ${msg.sender === 'user' ? 'flex-row-reverse' : 'flex-row'} items-start gap-2 sm:gap-3`}>
                    
                    {/* Avatar */}
                    <div className={`shrink-0 h-8 w-8 rounded-xl flex items-center justify-center mt-1 shadow-sm ${
                      msg.sender === 'user' ? 'bg-indigo-600' : 'bg-emerald-600'
                    }`}>
                      {msg.sender === 'user' ? <UserIcon /> : <BotIcon />}
                    </div>

                    {/* Content Box */}
                    <div className={`rounded-2xl p-4 shadow-sm border ${
                      msg.sender === 'user'
                        ? 'bg-indigo-600 text-white border-indigo-600 rounded-tr-none'
                        : 'bg-slate-50 text-slate-800 border-slate-200 rounded-tl-none'
                    }`}>
                      {msg.sender === 'user' ? (
                        <p className="whitespace-pre-wrap text-sm sm:text-base">{msg.text}</p>
                      ) : (
                        <div>
                          <FormattedText text={msg.text} />

                          {/* Grounding Sources */}
                          {msg.sources && msg.sources.length > 0 && (
                            <div className="mt-3 pt-2 border-t border-slate-200">
                              <p className="text-xs font-semibold text-slate-500 mb-1">🔍 Cited Sources:</p>
                              <div className="flex flex-wrap gap-1.5">
                                {msg.sources.map((src, i) => (
                                  <a
                                    key={i}
                                    href={src.uri}
                                    target="_blank"
                                    rel="noreferrer"
                                    className="text-[11px] bg-white border border-slate-300 text-indigo-600 hover:underline px-2 py-0.5 rounded"
                                  >
                                    {src.title || "Web Link"}
                                  </a>
                                ))}
                              </div>
                            </div>
                          )}

                          {/* Action Toolbar */}
                          <div className="mt-3 flex items-center gap-3 pt-2 border-t border-slate-200 text-slate-400 text-xs">
                            <button
                              onClick={() => handleSpeakText(msg.text)}
                              className="hover:text-indigo-600 flex items-center gap-1 font-medium"
                              title="Listen to note"
                            >
                              <SpeakerIcon /> Listen
                            </button>
                            <button
                              onClick={() => handleCopy(msg.text)}
                              className="hover:text-indigo-600 flex items-center gap-1 font-medium"
                              title="Copy response"
                            >
                              <CopyIcon /> Copy
                            </button>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              ))}

              {/* Typing Loader */}
              {isTyping && (
                <div className="flex justify-start items-center gap-3">
                  <div className="h-8 w-8 rounded-xl bg-emerald-600 flex items-center justify-center text-white">
                    <BotIcon />
                  </div>
                  <div className="bg-slate-100 border border-slate-200 p-3 rounded-2xl flex items-center gap-2 text-xs text-slate-500">
                    <span className="w-2 h-2 bg-indigo-600 rounded-full animate-ping"></span>
                    JRF Hunters AI is thinking & compiling NTA guidelines...
                  </div>
                </div>
              )}
              <div ref={messagesEndRef} />
            </div>

            {/* Input Form */}
            <form onSubmit={handleSendMessage} className="p-3 bg-slate-50 border-t border-slate-200 flex items-center gap-2">
              <input
                type="text"
                value={inputValue}
                onChange={(e) => setInputValue(e.target.value)}
                placeholder="Ask any UGC NET doubt (e.g. Paper 1 syllabus, Pramanas, Research Ethics, PYQs)..."
                className="flex-1 bg-white border border-slate-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600 shadow-sm"
                disabled={isTyping}
              />
              <button
                type="submit"
                disabled={!inputValue.trim() || isTyping}
                className="bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 text-white p-3 rounded-xl transition-all shadow-md flex items-center justify-center shrink-0"
              >
                <SendIcon />
              </button>
            </form>
          </div>
        )}

        {/* ================= UNITS EXPLORER TAB ================= */}
        {activeTab === 'units' && (
          <div className="h-full overflow-y-auto bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-4">
            <div>
              <h2 className="text-xl font-black text-indigo-950">Paper 1 Complete 10 Units Syllabus Navigator</h2>
              <p className="text-xs sm:text-sm text-slate-500">Explore core high-yield topics for all 10 Paper 1 units. Click to ask AI directly!</p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {PAPER_1_UNITS.map((unit) => (
                <div key={unit.id} className="border border-slate-200 hover:border-indigo-400 bg-slate-50/50 hover:bg-indigo-50/30 p-4 rounded-xl transition-all flex flex-col justify-between space-y-3">
                  <div>
                    <span className="text-[10px] font-bold bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded">
                      Unit {unit.id}
                    </span>
                    <h3 className="font-bold text-slate-900 mt-1 text-base">{unit.title}</h3>
                    
                    <ul className="mt-2 space-y-1 text-xs text-slate-600">
                      {unit.topics.map((t, idx) => (
                        <li key={idx} className="flex items-center gap-1.5">
                          <span className="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                          {t}
                        </li>
                      ))}
                    </ul>

                    <div className="mt-3 p-2.5 bg-amber-50 border border-amber-200 rounded-lg text-xs text-amber-900">
                      <span className="font-bold">🔥 High-Yield Tip:</span> {unit.highYield}
                    </div>
                  </div>

                  <button
                    onClick={() => {
                      setActiveTab('chat');
                      handleSendMessage(null, `Explain Unit ${unit.id}: ${unit.title} in detail with key formulas and PYQ trends.`);
                    }}
                    className="w-full bg-white hover:bg-indigo-600 hover:text-white border border-indigo-300 text-indigo-700 text-xs font-bold py-2 rounded-lg transition-colors flex items-center justify-center gap-1"
                  >
                    Ask AI detailed explanation for Unit {unit.id} &rarr;
                  </button>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ================= QUIZ GENERATOR TAB ================= */}
        {activeTab === 'quiz' && (
          <div className="h-full overflow-y-auto bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-6">
            <div>
              <h2 className="text-xl font-black text-indigo-950">AI Interactive Practice MCQ Quiz</h2>
              <p className="text-xs sm:text-sm text-slate-500">Select a unit to generate instant NTA-pattern practice questions with detailed explanations.</p>
            </div>

            {/* Config Controls */}
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200">
              <div>
                <label className="block text-xs font-bold text-slate-700 mb-1">Select Paper 1 Unit:</label>
                <select
                  value={selectedUnit}
                  onChange={(e) => setSelectedUnit(Number(e.target.value))}
                  className="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-medium focus:ring-2 focus:ring-indigo-600"
                >
                  {PAPER_1_UNITS.map((u) => (
                    <option key={u.id} value={u.id}>{u.title}</option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-700 mb-1">Difficulty Standard:</label>
                <select
                  value={quizDifficulty}
                  onChange={(e) => setQuizDifficulty(e.target.value)}
                  className="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-medium focus:ring-2 focus:ring-indigo-600"
                >
                  <option value="Basic">Basic Concepts</option>
                  <option value="Moderate">NTA Standard (Moderate)</option>
                  <option value="Advanced">Statement/Assertion-Reason (Advanced)</option>
                </select>
              </div>

              <div className="flex items-end">
                <button
                  onClick={generateQuiz}
                  disabled={isGeneratingQuiz}
                  className="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 rounded-lg text-xs transition-all shadow flex items-center justify-center gap-2"
                >
                  {isGeneratingQuiz ? 'Generating Questions...' : 'Generate 3 Practice MCQs'}
                </button>
              </div>
            </div>

            {/* Quiz Questions List */}
            {quizQuestions && quizQuestions.length > 0 && (
              <div className="space-y-6 border-t border-slate-200 pt-4">
                {quizQuestions.map((q, qIndex) => (
                  <div key={qIndex} className="bg-slate-50 border border-slate-200 p-4 rounded-xl space-y-3">
                    <p className="font-bold text-sm sm:text-base text-slate-900">
                      Q{qIndex + 1}. {q.question}
                    </p>

                    <div className="grid grid-cols-1 gap-2">
                      {q.options.map((opt, optIndex) => {
                        const isSelected = userAnswers[qIndex] === optIndex;
                        const isCorrect = q.correctIndex === optIndex;

                        let btnStyle = "bg-white border-slate-300 hover:bg-indigo-50 text-slate-800";
                        if (showQuizScore) {
                          if (isCorrect) btnStyle = "bg-emerald-100 border-emerald-500 text-emerald-900 font-bold";
                          else if (isSelected && !isCorrect) btnStyle = "bg-rose-100 border-rose-500 text-rose-900";
                        } else if (isSelected) {
                          btnStyle = "bg-indigo-600 text-white font-semibold";
                        }

                        return (
                          <button
                            key={optIndex}
                            onClick={() => !showQuizScore && setUserAnswers({ ...userAnswers, [qIndex]: optIndex })}
                            className={`w-full text-left p-3 rounded-lg border text-xs sm:text-sm transition-all ${btnStyle}`}
                          >
                            {opt}
                          </button>
                        );
                      })}
                    </div>

                    {showQuizScore && (
                      <div className="p-3 bg-indigo-50 border border-indigo-200 rounded-lg text-xs text-indigo-950 space-y-1">
                        <p className="font-bold text-indigo-900">
                          {userAnswers[qIndex] === q.correctIndex ? '✅ Correct Answer!' : '❌ Incorrect'}
                        </p>
                        <p><span className="font-semibold">Explanation:</span> {q.explanation}</p>
                      </div>
                    )}
                  </div>
                ))}

                <div className="flex gap-3 pt-2">
                  <button
                    onClick={() => setShowQuizScore(true)}
                    className="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-2.5 rounded-lg text-xs shadow"
                  >
                    Submit & View Explanations
                  </button>
                  <button
                    onClick={generateQuiz}
                    className="bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold px-4 py-2.5 rounded-lg text-xs"
                  >
                    Try Another Set
                  </button>
                </div>
              </div>
            )}
          </div>
        )}

        {/* ================= PLANNER TAB ================= */}
        {activeTab === 'planner' && (
          <div className="h-full overflow-y-auto bg-white rounded-2xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-6">
            <div>
              <h2 className="text-xl font-black text-indigo-950">Custom JRF Study Strategy & Timetable Builder</h2>
              <p className="text-xs sm:text-sm text-slate-500">Get an AI-generated day-by-day roadmap tailored to your paper schedule.</p>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
              <div>
                <label className="block text-xs font-bold text-slate-700 mb-1">Days Left For Exam:</label>
                <input
                  type="number"
                  value={examDays}
                  onChange={(e) => setExamDays(Number(e.target.value))}
                  className="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-medium"
                />
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-700 mb-1">Daily Study Hours:</label>
                <input
                  type="number"
                  value={dailyHours}
                  onChange={(e) => setDailyHours(Number(e.target.value))}
                  className="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-medium"
                />
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-700 mb-1">Paper 2 Subject:</label>
                <input
                  type="text"
                  value={targetPaper2}
                  onChange={(e) => setTargetPaper2(e.target.value)}
                  placeholder="e.g. Commerce, CS, English"
                  className="w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-medium"
                />
              </div>

              <div className="sm:col-span-3">
                <button
                  onClick={generateStudyPlan}
                  disabled={isGeneratingPlan}
                  className="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 rounded-lg text-xs transition-all shadow"
                >
                  {isGeneratingPlan ? 'Creating Personalized Roadmap...' : 'Generate My JRF Strategy Plan'}
                </button>
              </div>
            </div>

            {planResult && (
              <div className="bg-slate-50 border border-slate-200 p-5 rounded-xl space-y-3">
                <h3 className="font-bold text-indigo-900 border-b pb-2">Your JRF Strategy Plan</h3>
                <FormattedText text={planResult} />
              </div>
            )}
          </div>
        )}

      </main>
    </div>
  );
}