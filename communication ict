            // Fetch saved results from local storage
            const savedData = JSON.parse(localStorage.getItem('jrfHuntersMegaResults')) || [];
            const dashContent = document.getElementById('dashboard-content');
            
            if (savedData.length === 0) {
                dashContent.innerHTML = "<div class='empty-dash'>No candidate data found yet. Start an assessment to see your name and marks saved here!</div>";
            } else {
                let tableHTML = `
                    <table class="dashboard-table">
                        <tr>
                            <th>Date & Time</th>
                            <th>Candidate Name</th>
                            <th>Score</th>
                            <th>Status</th>
                        </tr>
                `;
                
                // Reverse to show newest first
                savedData.slice().reverse().forEach(attempt => {
                    let percent = ((attempt.score / 50) * 100).toFixed(1);
                    tableHTML += `
                        <tr>
                            <td>${attempt.date}</td>
                            <td><strong>${attempt.name}</strong></td>
                            <td><strong>${attempt.score} / 50</strong> (${percent}%)</td>
                            <td><span style="color: green;">Saved</span></td>
                        </tr>
                    `;
                });
                tableHTML += "</table>";
                dashContent.innerHTML = tableHTML;
            }
        }

        function showEnrollScreen() {
            hideAllScreens();
            document.getElementById('enroll-screen').classList.remove('hidden');
            document.getElementById('student-name').value = ""; // clear previous
        }

        function startQuiz() {
            const nameInput = document.getElementById('student-name').value;
            if (nameInput.trim() === "") { alert("Please enter your name to proceed."); return; }
            
            studentName = nameInput;
            currentQuestionIndex = 0;
            score = 0;
            
            // Initialize answers array with nulls to track skipped questions
            userAnswers = new Array(quizData.length).fill(null);
            
            hideAllScreens();
            document.getElementById('quiz-screen').classList.remove('hidden');
            loadQuestion();
        }

        function loadQuestion() {
            selectedOptionIndex = null;
            const currentQ = quizData[currentQuestionIndex];
            
            document.getElementById('question-tracker').innerText = `Question ${currentQuestionIndex + 1} of ${quizData.length}`;
            
            const passageDiv = document.getElementById('passage-container');
            if (currentQ.passage) {
                passageDiv.innerText = currentQ.passage;
                passageDiv.classList.remove('hidden');
            } else {
                passageDiv.classList.add('hidden');
            }

            document.getElementById('question-text').innerText = currentQ.q;
            
            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = "";
            
            currentQ.opts.forEach((option, index) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerText = option;
                btn.onclick = () => selectOption(index, btn);
                optionsContainer.appendChild(btn);
            });

            const nextBtn = document.getElementById('next-btn');
            const submitBtn = document.getElementById('submit-btn');
            
            if (currentQuestionIndex === quizData.length - 1) {
                nextBtn.classList.add('hidden');
                submitBtn.innerText = "Submit Final Test";
            } else {
                nextBtn.classList.remove('hidden');
                submitBtn.innerText = "Submit Early";
            }
        }

        function selectOption(index, btnElement) {
            selectedOptionIndex = index;
            const options = document.querySelectorAll('.option-btn');
            options.forEach(opt => opt.classList.remove('selected'));
            btnElement.classList.add('selected');
        }

        function nextQuestion() {
            if (selectedOptionIndex === null) { 
                alert("Please select an answer to proceed, or click 'Submit Early' if you wish to end the test now."); 
                return; 
            }
            
            // Record answer and update score
            userAnswers[currentQuestionIndex] = selectedOptionIndex;
            if (selectedOptionIndex === quizData[currentQuestionIndex].ans) { score++; }
            
            currentQuestionIndex++;
            
            if (currentQuestionIndex < quizData.length) { 
                loadQuestion(); 
            } else { 
                finishQuiz(); 
            }
        }

        function confirmSubmit() {
            // Check if they are on the last question anyway
            if (currentQuestionIndex === quizData.length - 1) {
                if (selectedOptionIndex !== null) {
                    userAnswers[currentQuestionIndex] = selectedOptionIndex;
                    if (selectedOptionIndex === quizData[currentQuestionIndex].ans) { score++; }
                }
                finishQuiz();
                return;
            }
            
            // Otherwise, prompt for early submission
            const remaining = quizData.length - currentQuestionIndex;
            const msg = `You have ${remaining} questions remaining. Are you sure you want to submit your assessment early? Unanswered questions will be marked as incorrect.`;
            
            if (confirm(msg)) {
                // Save current answer if they selected one before hitting submit early
                if (selectedOptionIndex !== null) {
                    userAnswers[currentQuestionIndex] = selectedOptionIndex;
                    if (selectedOptionIndex === quizData[currentQuestionIndex].ans) { score++; }
                }
                finishQuiz();
            }
        }

        function finishQuiz() {
            // Save Candidate Data to Local Storage (Website's database)
            const previousData = JSON.parse(localStorage.getItem('jrfHuntersMegaResults')) || [];
            
            // Format date nicely
            const now = new Date();
            const dateString = now.toLocaleDateString() + " " + now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            
            const attemptData = {
                name: studentName,
                score: score,
                date: dateString
            };
            
            previousData.push(attemptData);
            localStorage.setItem('jrfHuntersMegaResults', JSON.stringify(previousData));

            // Show results
            hideAllScreens();
            document.getElementById('result-screen').classList.remove('hidden');
            
            document.getElementById('display-name').innerText = studentName;
            document.getElementById('final-score').innerText = score;

            let feedback = "";
            let percentage = (score / quizData.length) * 100;
            if (percentage >= 80) feedback = "Excellent! You have a solid grasp on both ICT and Communication.";
            else if (percentage >= 50) feedback = "Good effort, but review the explanations to fix conceptual gaps.";
            else feedback = "Time to revise the notes. Focus on terminology and NTA PYQ traps!";
            document.getElementById('feedback-text').innerText = feedback;
        }

        function showAnalysis() {
            hideAllScreens();
            document.getElementById('analysis-screen').classList.remove('hidden');
            
            const container = document.getElementById('analysis-container');
            container.innerHTML = "";

            quizData.forEach((q, index) => {
                const userAnswerIdx = userAnswers[index];
                
                // Handle skipped questions from early submit
                const isSkipped = userAnswerIdx === null || userAnswerIdx === undefined;
                const isCorrect = !isSkipped && (userAnswerIdx === q.ans);
                
                let answerDisplay = "";
                if (isSkipped) {
                    answerDisplay = `<span class="text-gray">Skipped (No Answer Provided)</span>`;
                } else {
                    answerDisplay = `<span class="${isCorrect ? 'text-green' : 'text-red'}">
                        ${q.opts[userAnswerIdx]} ${isCorrect ? ' (Correct)' : ' (Incorrect)'}
                    </span>`;
                }

                const card = document.createElement('div');
                card.className = 'analysis-card';
                
                card.innerHTML = `
                    <div class="analysis-q-title">Q${index + 1}: ${q.q}</div>
                    <div class="analysis-response">
                        Your Answer: ${answerDisplay}
                    </div>
                    ${!isCorrect ? `<div class="analysis-response">Correct Answer: <span class="text-green">${q.opts[q.ans]}</span></div>` : ''}
                    <div class="analysis-rationale"><strong>Analysis:</strong> ${q.rat}</div>
                `;
                container.appendChild(card);
            });
        }

        // Boot up application
        window.onload = initDashboard;

    </script>
</body>
</html>
